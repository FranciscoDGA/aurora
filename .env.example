# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Número oficial da Aurora (só dígitos, com DDI+DDD). Vazio = botões de WhatsApp ficam ocultos.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# WhatsApp Business API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=aurora_verify_123

# Kiwify (webhook de pagamentos) — use pelo menos UM dos dois.
# Painel Kiwify → Webhooks: defina o token OU ative a assinatura HMAC-SHA256.
# Sem segredo, o endpoint recusa entregas em produção.
KIWIFY_WEBHOOK_TOKEN=
KIWIFY_WEBHOOK_SECRET=

# Stripe (opcional)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS=price_...
STRIPE_PRICE_PRO=price_...
